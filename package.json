{
  "name": "shuttle",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "pnpm --filter './packages/*' run build && pnpm --filter @shuttle/web run build",
    "typecheck": "pnpm -r run typecheck",
    "clean": "pnpm -r run clean",
    "dev": "SHUTTLE_CWD=\"$PWD\" pnpm -r --parallel run dev",
    "shuttle": "node packages/cli/bin/shuttle.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsdown": "^0.22.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
