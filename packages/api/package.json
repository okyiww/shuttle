{
  "name": "@shuttle/api",
  "version": "0.0.0",
  "description": "Shuttle BFF: hand-rolled node:http API + SSE bridging the web UI to ctx (llm/config/session), with config hot-reload and static hosting",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*"
  },
  "files": [
    "lib",
    "src"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf lib",
    "dev": "tsx watch src/dev.ts"
  },
  "dependencies": {
    "@shuttle/config": "workspace:*",
    "@shuttle/core": "workspace:*",
    "@shuttle/llm": "workspace:*",
    "@shuttle/llm-openai": "workspace:*",
    "@shuttle/mcp": "workspace:*",
    "@shuttle/memory": "workspace:*",
    "@shuttle/session": "workspace:*",
    "@shuttle/tools": "workspace:*"
  }
}
