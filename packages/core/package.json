{
  "name": "@shuttle/core",
  "version": "0.0.0",
  "description": "Mini plugin container distilled from Cordis: service registry, typed events (emit/waterfall/serial), effect/disposer lifecycle",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*"
  },
  "files": [
    "lib",
    "src"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf lib"
  }
}
